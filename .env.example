# Copy to .env and adjust. Never commit the real .env file.
DJANGO_SECRET_KEY=change-me
DJANGO_DEBUG=True
DJANGO_ALLOWED_HOSTS=localhost,127.0.0.1

# Set to True to skip PostgreSQL and use a local SQLite file.
# If False and PostgreSQL is not reachable, SQLite is used automatically.
USE_SQLITE=False

POSTGRES_DB=po_system
POSTGRES_USER=po_user
POSTGRES_PASSWORD=po_password
POSTGRES_HOST=localhost
POSTGRES_PORT=5432

# Optional: Google Gemini API key (free tier, from Google AI Studio) for AI commentary
# and syllabus parsing. Leave empty to run without AI.
GEMINI_API_KEY=
GEMINI_MODEL=gemini-flash-lite-latest

# Optional: e-mail for low-score alerts. By default messages are printed in the terminal
# (console backend). To send real mail, uncomment and fill in an SMTP server.
# EMAIL_BACKEND=django.core.mail.backends.smtp.EmailBackend
# EMAIL_HOST=smtp.example.com
# EMAIL_PORT=587
# EMAIL_HOST_USER=
# EMAIL_HOST_PASSWORD=
# EMAIL_USE_TLS=True
# DEFAULT_FROM_EMAIL=po-system@example.com
