# Copy to .env and adjust. Never commit the real .env file.
DJANGO_SECRET_KEY=change-me
DJANGO_DEBUG=True
DJANGO_ALLOWED_HOSTS=localhost,127.0.0.1

# Set to True to skip PostgreSQL and use a local SQLite file.
# If False and PostgreSQL is not reachable, SQLite is used automatically.
USE_SQLITE=False

POSTGRES_DB=po_system
POSTGRES_USER=po_user
POSTGRES_PASSWORD=po_password
POSTGRES_HOST=localhost
POSTGRES_PORT=5432
